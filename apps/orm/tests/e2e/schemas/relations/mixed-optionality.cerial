# Order has required customer, optional assignee
model Customer {
  id Record @id
  name String
  orders Relation[] @model(PurchaseOrder)
}

model Agent {
  id Record @id
  name String
  assignedOrders Relation[] @model(PurchaseOrder)
}

model PurchaseOrder {
  id Record @id
  orderNumber String @unique
  customerId Record
  customer Relation @field(customerId) @model(Customer)
  assigneeId Record? @nullable
  assignee Relation? @field(assigneeId) @model(Agent)
}
