model SzOwner {
  id Record @id
  name String
  readings Relation[] @model(SzReading)
}

model SzReading {
  id Record @id
  ownerId Record
  owner Relation @field(ownerId) @model(SzOwner)
  channel Uint8
  level Float32
  counter Uint64
}

model SzRawHolder {
  id Record @id
  numVal Number
  anyVal Any
}
