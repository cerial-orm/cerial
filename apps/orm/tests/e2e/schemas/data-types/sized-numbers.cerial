# Sized number types (SurrealDB 4.0): Int8 Uint8 Int16 Uint16 Int32 Uint32 Uint64 Float16 Float32
# One model per type with every field form: required, optional, @nullable, array, @set, @default, object field, tuple.
# Plus owner/reading models for include, and a Number and Any holder for the raw-write read.

object SzInt8Obj {
  val Int8
  opt Int8?
}

tuple SzInt8Tup {
  Int8,
  Int8 @nullable
}

model SzInt8 {
  id Record @id
  reqVal Int8
  optVal Int8?
  nullVal Int8 @nullable
  arrVal Int8[]
  setVal Int8[] @set
  dfltVal Int8 @default(-5)
  objVal SzInt8Obj
  tupVal SzInt8Tup
}

object SzUint8Obj {
  val Uint8
  opt Uint8?
}

tuple SzUint8Tup {
  Uint8,
  Uint8 @nullable
}

model SzUint8 {
  id Record @id
  reqVal Uint8
  optVal Uint8?
  nullVal Uint8 @nullable
  arrVal Uint8[]
  setVal Uint8[] @set
  dfltVal Uint8 @default(7)
  objVal SzUint8Obj
  tupVal SzUint8Tup
}

