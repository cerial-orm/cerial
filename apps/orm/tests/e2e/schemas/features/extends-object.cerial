// Object extends with private fields, pick/omit, override

object ExtBaseAddress {
  street String
  city String
  zip String
  country String @default('US')
}

// Object extending base
object ExtAddress extends ExtBaseAddress {
  apartment String?
  coordinates Float[]
}

// Object with pick
object ExtCityAddress extends ExtBaseAddress[city, country] {
  district String?
}

// Object with omit
object ExtSimpleAddress extends ExtBaseAddress[!country] {
  region String?
}

// Object with override
object ExtDetailedAddress extends ExtBaseAddress {
  country String @default('USA')
  latitude Float?
  longitude Float?
  timezone String?
}

// Object with !!private fields
object ExtPrivateAddress extends ExtBaseAddress {
  street String !!private
  zip String !!private
  publicCity String?
}

// Multi-level object inheritance
object ExtGeoAddress extends ExtAddress {
  elevation Float?
  timezone String @default('UTC')
}

// Object with various field types
object ExtMetaAddress extends ExtBaseAddress {
  verified Bool @default(false)
  verifiedAt Date?
  tags String[]
  rating Int?
}

// Model using extended objects
model ExtAddressUser {
  id Record @id
  name String
  homeAddress ExtAddress
  workAddress ExtDetailedAddress?
  previousAddresses ExtGeoAddress[]
}

// Two-level chains: a filter on a parent that is itself filtered the other way.
// A filter names the parent's own fields, so each link in the chain declares its own.
object ExtChainBase {
  a String
  b String
  c String
}

object ExtChainPicked extends ExtChainBase[a, b] {
  p String
  q String
}

object ExtChainPickedThenOmitted extends ExtChainPicked[!p] {
  r String?
}

object ExtChainOmitted extends ExtChainBase[!c] {
  p String
  q String
}

object ExtChainOmittedThenPicked extends ExtChainOmitted[q] {
  r String?
}

model ExtChainModel {
  id Record @id
  pickThenOmit ExtChainPickedThenOmitted
  omitThenPick ExtChainOmittedThenPicked
}
