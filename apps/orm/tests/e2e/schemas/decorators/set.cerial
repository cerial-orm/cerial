model SetBasic {
  id Record @id
  name String
  tags String[] @set
  numbers Int[] @set
  uuids Uuid[] @set
}

model SetDecimal {
  id Record @id
  name String
  prices Decimal[] @set
}

object SetBag {
  tags String[] @set
  nums Int[]
}

model SetNested {
  id Record @id
  name String
  bag SetBag?
  strictBag SetBag
}
