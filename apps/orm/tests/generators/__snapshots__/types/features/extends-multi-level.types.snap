  exists(where?: ExtP4ConcreteWhere, txn?: CerialTransaction): CerialQueryPromise<boolean>;

  $raw<R = unknown>(fragment: SqlFragment<R>, options?: { txn?: CerialTransaction }): CerialQueryPromise<R[]>;

  $live(options?: { where?: ExtP4ConcreteWhere }): Promise<import('cerial').CerialLiveHandle<ExtP4Concrete>>;

  getMetadata(): ModelMetadata;

  getName(): string;

  getTableName(): string;
}
