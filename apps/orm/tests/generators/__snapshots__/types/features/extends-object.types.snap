  city: string;
  zip: string;
  region?: string;
}

export interface ExtSimpleAddressInput {
  street: string;
  city: string;
  zip: string;
  region?: string;
}

export interface ExtSimpleAddressWhere {
  street?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {});
  city?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {});
  zip?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {});
  region?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {
        not?: string;
        isNone?: boolean;
      });
  AND?: ExtSimpleAddressWhere[];
  OR?: ExtSimpleAddressWhere[];
  NOT?: ExtSimpleAddressWhere;
}

export interface ExtSimpleAddressSelectFields {
  street?: boolean;
  city?: boolean;
  zip?: boolean;
  region?: boolean;
}

export type ExtSimpleAddressSelect = AtLeastOne<ExtSimpleAddressSelectFields>;

export interface ExtSimpleAddressOrderBy {
  street?: 'asc' | 'desc';
  city?: 'asc' | 'desc';
  zip?: 'asc' | 'desc';
  region?: 'asc' | 'desc';
}
