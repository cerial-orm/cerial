import type { AtLeastOne } from '../index.js';
export interface Location {
  city: string;
  zip: string;
  street?: string;
}

export interface LocationInput {
  city: string;
  zip: string;
  street?: string;
}

export interface LocationWhere {
  city?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {});
  zip?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {});
  street?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {
        not?: string;
        isNone?: boolean;
      });
  AND?: LocationWhere[];
  OR?: LocationWhere[];
  NOT?: LocationWhere;
}

export interface LocationSelectFields {
  city?: boolean;
  zip?: boolean;
  street?: boolean;
}

export type LocationSelect = AtLeastOne<LocationSelectFields>;

export interface LocationOrderBy {
  city?: 'asc' | 'desc';
  zip?: 'asc' | 'desc';
  street?: 'asc' | 'desc';
}
