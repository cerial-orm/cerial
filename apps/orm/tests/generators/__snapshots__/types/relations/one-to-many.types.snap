    where: PostRequiredFindUniqueWhere;
    create: PostRequiredCreateInput;
    update?: DataArg<D, PostRequiredUpdateInput>;
    unset?: SafeUnset<PostRequiredUnset, D>;
    select?: SelectArg<S, PostRequiredSelectFields>;
    include?: IncludeArg<I, PostRequiredInclude>;
    /**
     * Return option for the upserted record
     * - undefined/null/'after': returns upserted record (supports select/include)
     * - true: returns boolean (true if record was created or updated)
     * - 'before': returns previous state | null (null for new records)
     */
    return?: R;
    txn?: CerialTransaction;
  }): CerialQueryPromise<UpsertReturnType<GetPostRequiredPayload<S, I>, R>>;

  upsert<
    S extends PostRequiredSelect | undefined = undefined,
    I extends PostRequiredInclude | undefined = undefined,
    D extends PostRequiredUpdateInput = PostRequiredUpdateInput,
    R extends UpsertReturn = undefined,
  >(options: {
    where: PostRequiredWhere;
    create: PostRequiredCreateInput;
    update?: DataArg<D, PostRequiredUpdateInput>;
    unset?: SafeUnset<PostRequiredUnset, D>;
    select?: SelectArg<S, PostRequiredSelectFields>;
    include?: IncludeArg<I, PostRequiredInclude>;
    /**
     * Return option for the upserted record
     * - undefined/null/'after': returns upserted records
     * - true: returns boolean (true if any records were affected)
     * - 'before': returns previous states of matched records
     */
    return?: R;
    txn?: CerialTransaction;
  }): CerialQueryPromise<UpsertArrayReturnType<GetPostRequiredPayload<S, I>, R>>;

  deleteMany(options: { where: PostRequiredWhere; txn?: CerialTransaction }): CerialQueryPromise<number>;

  deleteUnique<R extends DeleteUniqueReturn = undefined>(options: {
    where: PostRequiredFindUniqueWhere;
    /**
     * Return option for the deleted record
     * - undefined/null: returns boolean (always true - operation succeeded)
     * - true: returns boolean (true if record existed, false if not)
     * - 'before': returns PostRequired | null (deleted data)
     */
    return?: R;
    txn?: CerialTransaction;
  }): CerialQueryPromise<DeleteUniqueReturnType<PostRequired, R>>;

  count(where?: PostRequiredWhere, txn?: CerialTransaction): CerialQueryPromise<number>;

  groupBy<const A extends PostRequiredGroupByArgs>(
    args: GroupByArg<A, PostRequiredGroupByArgs>,
    txn?: CerialTransaction,
  ): CerialQueryPromise<PostRequiredGroupByResult<A>[]>;

  exists(where?: PostRequiredWhere, txn?: CerialTransaction): CerialQueryPromise<boolean>;

  $raw<R = unknown>(fragment: SqlFragment<R>, options?: { txn?: CerialTransaction }): CerialQueryPromise<R[]>;

  $live(options?: { where?: PostRequiredWhere }): Promise<import('cerial').CerialLiveHandle<PostRequired>>;

  getMetadata(): ModelMetadata;

  getName(): string;

  getTableName(): string;
}
