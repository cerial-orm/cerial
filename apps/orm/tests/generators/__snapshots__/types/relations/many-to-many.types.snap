     */
    return?: R;
    txn?: CerialTransaction;
  }): CerialQueryPromise<UpsertArrayReturnType<GetCoursePayload<S, I>, R>>;

  deleteMany(options: { where: CourseWhere; txn?: CerialTransaction }): CerialQueryPromise<number>;

  deleteUnique<R extends DeleteUniqueReturn = undefined>(options: {
