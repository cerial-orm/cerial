export interface Course {
  id: CerialId<string>;
  name: string;
  code: string;
  studentIds: CerialId<string>[];
}

export interface CourseInput {
  id?: string;
  name: string;
  code: string;
  studentIds: RecordIdInput<string>[];
}

export interface CourseWhere {
  id?:
    | RecordIdInput<string>
    | ({
        eq?: RecordIdInput<string>;
        neq?: RecordIdInput<string>;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: RecordIdInput<string>[];
        notIn?: RecordIdInput<string>[];
      } & {});
  name?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {});
  /** @unique — Unique indexed field */
  code?:
    | string
    | ({
        eq?: string;
        neq?: string;
      } & {
        contains?: string;
        startsWith?: string;
        endsWith?: string;
      } & {
        in?: string[];
        notIn?: string[];
      } & {});
  studentIds?:
    | RecordIdInput<string>[]
    | {
        has?: RecordIdInput<string>;
        hasAll?: RecordIdInput<string>[];
        hasAny?: RecordIdInput<string>[];
        isEmpty?: boolean;
      };
  students?: {
    some?: Omit<StudentWhere, '$raw'>;
    every?: Omit<StudentWhere, '$raw'>;
    none?: Omit<StudentWhere, '$raw'>;
  };
  $raw?: SqlFragment;
  AND?: CourseWhere[];
  OR?: CourseWhere[];
  NOT?: CourseWhere;
