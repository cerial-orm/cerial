export type CourseWhereInput = CourseWhere;

export type CourseFindUniqueWhere =
  | ({ id: RecordIdInput<string> } & { code?: string } & Omit<CourseWhere, 'id' | 'code'>)
  | ({ code: string } & { id?: RecordIdInput<string> } & Omit<CourseWhere, 'id' | 'code'>);

export type CourseCreate = O.Optional<O.Omit<CourseInput, 'students'>, 'id' | 'studentIds'>;

export type CourseNestedCreate = O.Optional<O.Omit<CourseInput, 'students' | 'studentIds'>, 'id'>;

export type CourseCreateInput =
  | CourseCreate
  | (O.Omit<CourseCreate, 'studentIds'> & {
      students?: {
        create?: StudentNestedCreate | StudentNestedCreate[];
        connect?: RecordIdInput | RecordIdInput[];
      };
    });

export type CourseUpdate = Partial<O.Omit<CourseInput, 'id' | 'students' | 'studentIds'>> & {
  studentIds?:
    | RecordIdInput<string>[]
    | {
        push?: RecordIdInput<string> | RecordIdInput<string>[];
        unset?: RecordIdInput<string> | RecordIdInput<string>[];
      };
};

export type CourseUpdateInput =
  | CourseUpdate
  | (O.Omit<CourseUpdate, 'studentIds'> & {
      students?: {
        create?: StudentNestedCreate | StudentNestedCreate[];
        connect?: RecordIdInput | RecordIdInput[];
        disconnect?: RecordIdInput | RecordIdInput[];
        set?: RecordIdInput[];
      };
    });

export type CourseUnset = {};

export type CourseSelect =
  | ({ id: boolean } & Partial<Record<'name' | 'code' | 'studentIds', boolean>>)
  | ({ name: boolean } & Partial<Record<'id' | 'code' | 'studentIds', boolean>>)
  | ({ code: boolean } & Partial<Record<'id' | 'name' | 'studentIds', boolean>>)
  | ({ studentIds: boolean } & Partial<Record<'id' | 'name' | 'code', boolean>>);

export interface CourseOrderBy {
  id?: 'asc' | 'desc';
  name?: 'asc' | 'desc';
  code?: 'asc' | 'desc';
  studentIds?: 'asc' | 'desc';
}

export interface CourseInclude {
  students?:
    | boolean
    | {
        select?: StudentSelect;
        where?: StudentWhere;
        orderBy?: StudentOrderBy;
        limit?: number;
        offset?: number;
        include?: StudentInclude;
      };
}

export type Course$Relations = {
  students: { type: Student[]; include: StudentInclude };
};

export type GetCourseIncludePayload<I extends CourseInclude | undefined> = I extends CourseInclude
  ? Pick<
      {
        students: I['students'] extends true
          ? Student[]
          : I['students'] extends { select: infer S extends StudentSelect; include: infer NI extends StudentInclude }
            ? ({
                [P in keyof S as S[P] extends false | undefined ? never : P]: P extends keyof Student
                  ? ResolveFieldSelect<Student[P], S[P]>
                  : never;
              } & GetStudentIncludePayload<NI>)[]
            : I['students'] extends { select: infer S extends StudentSelect }
              ? {
                  [P in keyof S as S[P] extends false | undefined ? never : P]: P extends keyof Student
                    ? ResolveFieldSelect<Student[P], S[P]>
                    : never;
                }[]
              : I['students'] extends { include: infer NI extends StudentInclude }
                ? (Student & GetStudentIncludePayload<NI>)[]
                : Student[];
      },
      Extract<keyof I, keyof Course$Relations> & { [K in keyof I]: I[K] extends false | undefined ? never : K }[keyof I]
    >
  : {};

export type GetCoursePayload<
  S extends CourseSelect | undefined = undefined,
  I extends CourseInclude | undefined = undefined,
> = A.Compute<
  S extends CourseSelect
    ? {
        [K in keyof S as S[K] extends false | undefined ? never : K]: K extends keyof Course
          ? ResolveFieldSelect<Course[K], S[K]>
          : never;
      } & GetCourseIncludePayload<I>
    : I extends CourseInclude
      ? Course & GetCourseIncludePayload<I>
      : Course,
  'flat'
>;

