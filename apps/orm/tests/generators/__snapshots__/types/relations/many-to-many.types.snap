    I extends CourseInclude | undefined = undefined,
    D extends CourseUpdateInput = CourseUpdateInput,
  >(options: {
    where: CourseWhere;
    data: D;
    unset?: SafeUnset<CourseUnset, D>;
    select?: S;
    include?: I;
    txn?: CerialTransaction;
  }): CerialQueryPromise<GetCoursePayload<S, I>[]>;

  updateUnique<
    S extends CourseSelect | undefined = undefined,
    I extends CourseInclude | undefined = undefined,
    D extends CourseUpdateInput = CourseUpdateInput,
    R extends UpdateUniqueReturn = undefined,
  >(options: {
    where: CourseFindUniqueWhere;
    data: D;
    unset?: SafeUnset<CourseUnset, D>;
    select?: S;
    include?: I;
    /**
     * Return option for the updated record
     * - undefined/null/'after': returns updated record (supports select/include)
     * - true: returns boolean (true if found and updated, false if not)
     * - 'before': returns Course | null (pre-update state, select and include read before the write)
     */
    return?: R;
    txn?: CerialTransaction;
  }): CerialQueryPromise<UpdateUniqueReturnType<GetCoursePayload<S, I>, R>>;

  upsert<
    S extends CourseSelect | undefined = undefined,
    I extends CourseInclude | undefined = undefined,
    D extends CourseUpdateInput = CourseUpdateInput,
    R extends UpsertReturn = undefined,
  >(options: {
    where: CourseFindUniqueWhere;
    create: CourseCreateInput;
    update?: D;
    unset?: SafeUnset<CourseUnset, D>;
    select?: S;
    include?: I;
    /**
     * Return option for the upserted record
     * - undefined/null/'after': returns upserted record (supports select/include)
     * - true: returns boolean (true if record was created or updated)
     * - 'before': returns previous state | null (null for new records)
     */
    return?: R;
    txn?: CerialTransaction;
  }): CerialQueryPromise<UpsertReturnType<GetCoursePayload<S, I>, R>>;

  upsert<
    S extends CourseSelect | undefined = undefined,
    I extends CourseInclude | undefined = undefined,
    D extends CourseUpdateInput = CourseUpdateInput,
    R extends UpsertReturn = undefined,
  >(options: {
    where: CourseWhere;
    create: CourseCreateInput;
    update?: D;
    unset?: SafeUnset<CourseUnset, D>;
    select?: S;
    include?: I;
    /**
