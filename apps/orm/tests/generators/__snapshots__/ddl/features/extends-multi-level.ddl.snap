-- ExtP4Concrete
DEFINE TABLE OVERWRITE ext_p4_concrete SCHEMAFULL;
DEFINE FIELD OVERWRITE secret ON TABLE ext_p4_concrete TYPE string;
DEFINE FIELD OVERWRITE name ON TABLE ext_p4_concrete TYPE string;
DEFINE FIELD OVERWRITE tag ON TABLE ext_p4_concrete TYPE string;
DEFINE FIELD OVERWRITE extra ON TABLE ext_p4_concrete TYPE option<string>;
