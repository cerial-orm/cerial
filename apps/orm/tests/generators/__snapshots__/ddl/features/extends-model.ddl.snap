DEFINE FIELD OVERWRITE level ON TABLE ext_system_admin TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE permissions ON TABLE ext_system_admin TYPE array<string>;
DEFINE FIELD OVERWRITE systemAccess ON TABLE ext_system_admin TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE auditLog ON TABLE ext_system_admin TYPE array<string>;
DEFINE INDEX OVERWRITE ext_system_admin_email_unique ON TABLE ext_system_admin COLUMNS email UNIQUE;

-- ExtUser
DEFINE TABLE OVERWRITE ext_user SCHEMAFULL;
DEFINE FIELD OVERWRITE createdAt ON TABLE ext_user TYPE option<datetime> DEFAULT time::now();
DEFINE FIELD OVERWRITE updatedAt ON TABLE ext_user TYPE option<datetime> DEFAULT ALWAYS time::now();
DEFINE FIELD OVERWRITE email ON TABLE ext_user TYPE string ASSERT string::is_email($value);
DEFINE FIELD OVERWRITE name ON TABLE ext_user TYPE string;
DEFINE FIELD OVERWRITE isActive ON TABLE ext_user TYPE bool DEFAULT true;
DEFINE FIELD OVERWRITE age ON TABLE ext_user TYPE option<int>;
DEFINE FIELD OVERWRITE role ON TABLE ext_user TYPE string DEFAULT 'user';
DEFINE INDEX OVERWRITE ext_user_email_unique ON TABLE ext_user COLUMNS email UNIQUE;
