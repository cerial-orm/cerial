DEFINE FIELD OVERWRITE deepTuple[1].deep.note ON TABLE unset_test TYPE option<string>;
DEFINE FIELD OVERWRITE tree ON TABLE unset_test TYPE option<object> FLEXIBLE;
DEFINE FIELD OVERWRITE recursive ON TABLE unset_test TYPE option<[string, [] | null]>;
