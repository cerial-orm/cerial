-- EnumBasic
DEFINE TABLE OVERWRITE enum_basic SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE enum_basic TYPE string;
DEFINE FIELD OVERWRITE role ON TABLE enum_basic TYPE 'ADMIN' | 'USER' | 'MODERATOR';
DEFINE FIELD OVERWRITE optRole ON TABLE enum_basic TYPE option<'ADMIN' | 'USER' | 'MODERATOR'>;
DEFINE FIELD OVERWRITE nullRole ON TABLE enum_basic TYPE option<'ADMIN' | 'USER' | 'MODERATOR' | null>;
DEFINE FIELD OVERWRITE roles ON TABLE enum_basic TYPE array<'ADMIN' | 'USER' | 'MODERATOR'>;

-- EnumDefaults
DEFINE TABLE OVERWRITE enum_defaults SCHEMAFULL;
DEFINE FIELD OVERWRITE label ON TABLE enum_defaults TYPE string;
DEFINE FIELD OVERWRITE role ON TABLE enum_defaults TYPE 'ADMIN' | 'USER' | 'MODERATOR' DEFAULT 'ADMIN';
DEFINE FIELD OVERWRITE severity ON TABLE enum_defaults TYPE 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL' DEFAULT 'LOW';

-- EnumLiteralRef
DEFINE TABLE OVERWRITE enum_literal_ref SCHEMAFULL;
DEFINE FIELD OVERWRITE visibility ON TABLE enum_literal_ref TYPE 'ADMIN' | 'USER' | 'MODERATOR' | 'custom';

-- EnumMultiple
DEFINE TABLE OVERWRITE enum_multiple SCHEMAFULL;
DEFINE FIELD OVERWRITE title ON TABLE enum_multiple TYPE string;
DEFINE FIELD OVERWRITE role ON TABLE enum_multiple TYPE 'ADMIN' | 'USER' | 'MODERATOR';
DEFINE FIELD OVERWRITE color ON TABLE enum_multiple TYPE 'RED' | 'GREEN' | 'BLUE';
DEFINE FIELD OVERWRITE severity ON TABLE enum_multiple TYPE 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL';

-- EnumWithObject
DEFINE TABLE OVERWRITE enum_with_object SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE enum_with_object TYPE string;
DEFINE FIELD OVERWRITE address ON TABLE enum_with_object TYPE object;
DEFINE FIELD OVERWRITE address.city ON TABLE enum_with_object TYPE string;
DEFINE FIELD OVERWRITE address.severity ON TABLE enum_with_object TYPE 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL';
DEFINE FIELD OVERWRITE optAddress ON TABLE enum_with_object TYPE option<object>;
DEFINE FIELD OVERWRITE optAddress.city ON TABLE enum_with_object TYPE string;
DEFINE FIELD OVERWRITE optAddress.severity ON TABLE enum_with_object TYPE 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL';
