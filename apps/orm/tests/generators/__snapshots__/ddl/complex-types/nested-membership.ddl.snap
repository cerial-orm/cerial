-- NmObjectDoc
DEFINE TABLE OVERWRITE nm_object_doc SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE nm_object_doc TYPE string;
DEFINE FIELD OVERWRITE leaf ON TABLE nm_object_doc TYPE option<object>;
DEFINE FIELD OVERWRITE leaf.grade ON TABLE nm_object_doc TYPE 'LOW' | 'MID' | 'HIGH';
DEFINE FIELD OVERWRITE leaf.code ON TABLE nm_object_doc TYPE option<'a1' | 'b2' | 7>;
DEFINE FIELD OVERWRITE mid ON TABLE nm_object_doc TYPE option<object>;
DEFINE FIELD OVERWRITE mid.label ON TABLE nm_object_doc TYPE string;
DEFINE FIELD OVERWRITE mid.leaf ON TABLE nm_object_doc TYPE object;
DEFINE FIELD OVERWRITE mid.leaf.grade ON TABLE nm_object_doc TYPE 'LOW' | 'MID' | 'HIGH';
DEFINE FIELD OVERWRITE mid.leaf.code ON TABLE nm_object_doc TYPE option<'a1' | 'b2' | 7>;
DEFINE FIELD OVERWRITE top ON TABLE nm_object_doc TYPE option<object>;
DEFINE FIELD OVERWRITE top.title ON TABLE nm_object_doc TYPE string;
DEFINE FIELD OVERWRITE top.mid ON TABLE nm_object_doc TYPE object;
DEFINE FIELD OVERWRITE top.mid.label ON TABLE nm_object_doc TYPE string;
DEFINE FIELD OVERWRITE top.mid.leaf ON TABLE nm_object_doc TYPE object;
DEFINE FIELD OVERWRITE top.mid.leaf.grade ON TABLE nm_object_doc TYPE 'LOW' | 'MID' | 'HIGH';
DEFINE FIELD OVERWRITE top.mid.leaf.code ON TABLE nm_object_doc TYPE option<'a1' | 'b2' | 7>;
DEFINE FIELD OVERWRITE leaves ON TABLE nm_object_doc TYPE array<object>;
DEFINE FIELD OVERWRITE leaves.*.grade ON TABLE nm_object_doc TYPE 'LOW' | 'MID' | 'HIGH';
DEFINE FIELD OVERWRITE leaves.*.code ON TABLE nm_object_doc TYPE option<'a1' | 'b2' | 7>;
DEFINE FIELD OVERWRITE tops ON TABLE nm_object_doc TYPE array<object>;
DEFINE FIELD OVERWRITE tops.*.title ON TABLE nm_object_doc TYPE string;
DEFINE FIELD OVERWRITE tops.*.mid ON TABLE nm_object_doc TYPE object;
DEFINE FIELD OVERWRITE tops.*.mid.label ON TABLE nm_object_doc TYPE string;
DEFINE FIELD OVERWRITE tops.*.mid.leaf ON TABLE nm_object_doc TYPE object;
DEFINE FIELD OVERWRITE tops.*.mid.leaf.grade ON TABLE nm_object_doc TYPE 'LOW' | 'MID' | 'HIGH';
DEFINE FIELD OVERWRITE tops.*.mid.leaf.code ON TABLE nm_object_doc TYPE option<'a1' | 'b2' | 7>;

-- NmTupleDoc
DEFINE TABLE OVERWRITE nm_tuple_doc SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE nm_tuple_doc TYPE string;
DEFINE FIELD OVERWRITE withLeaf ON TABLE nm_tuple_doc TYPE option<[string, { grade: 'LOW' | 'MID' | 'HIGH', code: option<'a1' | 'b2' | 7> }]>;
DEFINE FIELD OVERWRITE named ON TABLE nm_tuple_doc TYPE option<[string, { grade: 'LOW' | 'MID' | 'HIGH', code: option<'a1' | 'b2' | 7> }]>;
DEFINE FIELD OVERWRITE outer ON TABLE nm_tuple_doc TYPE option<[[string, { grade: 'LOW' | 'MID' | 'HIGH', code: option<'a1' | 'b2' | 7> }], int]>;
DEFINE FIELD OVERWRITE holds ON TABLE nm_tuple_doc TYPE option<object>;
DEFINE FIELD OVERWRITE holds.entry ON TABLE nm_tuple_doc TYPE [string, { grade: 'LOW' | 'MID' | 'HIGH', code: option<'a1' | 'b2' | 7> }];
DEFINE FIELD OVERWRITE deepHolds ON TABLE nm_tuple_doc TYPE option<object>;
DEFINE FIELD OVERWRITE deepHolds.holder ON TABLE nm_tuple_doc TYPE object;
DEFINE FIELD OVERWRITE deepHolds.holder.entry ON TABLE nm_tuple_doc TYPE [string, { grade: 'LOW' | 'MID' | 'HIGH', code: option<'a1' | 'b2' | 7> }];
DEFINE FIELD OVERWRITE withLeaves ON TABLE nm_tuple_doc TYPE array<[string, { grade: 'LOW' | 'MID' | 'HIGH', code: option<'a1' | 'b2' | 7> }]>;
DEFINE FIELD OVERWRITE nameds ON TABLE nm_tuple_doc TYPE array<[string, { grade: 'LOW' | 'MID' | 'HIGH', code: option<'a1' | 'b2' | 7> }]>;
