-- Agent
DEFINE TABLE OVERWRITE agent SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE agent TYPE string;

-- Customer
DEFINE TABLE OVERWRITE customer SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE customer TYPE string;

-- PurchaseOrder
DEFINE TABLE OVERWRITE purchase_order SCHEMAFULL;
DEFINE FIELD OVERWRITE orderNumber ON TABLE purchase_order TYPE string;
DEFINE FIELD OVERWRITE customerId ON TABLE purchase_order TYPE record<customer>;
DEFINE FIELD OVERWRITE assigneeId ON TABLE purchase_order TYPE option<record<agent> | null>;
DEFINE INDEX OVERWRITE purchase_order_orderNumber_unique ON TABLE purchase_order COLUMNS orderNumber UNIQUE;
