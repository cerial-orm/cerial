-- SzFloat16
DEFINE TABLE OVERWRITE sz_float16 SCHEMAFULL;
DEFINE FIELD OVERWRITE reqVal ON TABLE sz_float16 TYPE f16;
DEFINE FIELD OVERWRITE optVal ON TABLE sz_float16 TYPE option<f16>;
DEFINE FIELD OVERWRITE nullVal ON TABLE sz_float16 TYPE f16 | null;
DEFINE FIELD OVERWRITE arrVal ON TABLE sz_float16 TYPE array<f16>;
DEFINE FIELD OVERWRITE setVal ON TABLE sz_float16 TYPE set<f16>;
DEFINE FIELD OVERWRITE dfltVal ON TABLE sz_float16 TYPE f16 DEFAULT 1.5f16;
DEFINE FIELD OVERWRITE objVal ON TABLE sz_float16 TYPE object;
DEFINE FIELD OVERWRITE objVal.val ON TABLE sz_float16 TYPE f16;
DEFINE FIELD OVERWRITE objVal.opt ON TABLE sz_float16 TYPE option<f16>;
DEFINE FIELD OVERWRITE tupVal ON TABLE sz_float16 TYPE [f16, f16 | null];

-- SzFloat32
DEFINE TABLE OVERWRITE sz_float32 SCHEMAFULL;
DEFINE FIELD OVERWRITE reqVal ON TABLE sz_float32 TYPE f32;
DEFINE FIELD OVERWRITE optVal ON TABLE sz_float32 TYPE option<f32>;
DEFINE FIELD OVERWRITE nullVal ON TABLE sz_float32 TYPE f32 | null;
DEFINE FIELD OVERWRITE arrVal ON TABLE sz_float32 TYPE array<f32>;
DEFINE FIELD OVERWRITE setVal ON TABLE sz_float32 TYPE set<f32>;
DEFINE FIELD OVERWRITE dfltVal ON TABLE sz_float32 TYPE f32 DEFAULT 2.5f32;
DEFINE FIELD OVERWRITE objVal ON TABLE sz_float32 TYPE object;
DEFINE FIELD OVERWRITE objVal.val ON TABLE sz_float32 TYPE f32;
DEFINE FIELD OVERWRITE objVal.opt ON TABLE sz_float32 TYPE option<f32>;
DEFINE FIELD OVERWRITE tupVal ON TABLE sz_float32 TYPE [f32, f32 | null];

