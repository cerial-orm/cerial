-- SzOwner
DEFINE TABLE OVERWRITE sz_owner SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE sz_owner TYPE string;

-- SzRawHolder
DEFINE TABLE OVERWRITE sz_raw_holder SCHEMAFULL;
DEFINE FIELD OVERWRITE numVal ON TABLE sz_raw_holder TYPE number;
DEFINE FIELD OVERWRITE anyVal ON TABLE sz_raw_holder TYPE any;

-- SzReading
DEFINE TABLE OVERWRITE sz_reading SCHEMAFULL;
DEFINE FIELD OVERWRITE ownerId ON TABLE sz_reading TYPE record<sz_owner>;
DEFINE FIELD OVERWRITE channel ON TABLE sz_reading TYPE u8;
DEFINE FIELD OVERWRITE level ON TABLE sz_reading TYPE f32;
DEFINE FIELD OVERWRITE counter ON TABLE sz_reading TYPE u64;

