{
  "name": "cerial",
  "version": "0.2.0",
  "description": "A Prisma-like ORM for SurrealDB with schema-driven code generation and full TypeScript type safety",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerial-orm/cerial.git",
    "directory": "apps/orm"
  },
  "homepage": "https://cerial-orm.github.io/cerial",
  "bugs": {
    "url": "https://github.com/cerial-orm/cerial/issues"
  },
  "author": "younusdev",
  "keywords": [
    "surrealdb",
    "orm",
    "prisma",
    "typescript",
    "codegen",
    "schema",
    "query-builder",
    "database"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "cerial": "./dist/bin/cerial.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser/index.d.mts",
        "default": "./dist/parser/index.mjs"
      },
      "require": {
        "types": "./dist/parser/index.d.cts",
        "default": "./dist/parser/index.cjs"
      }
    },
    "./generators": {
      "import": {
        "types": "./dist/generators/index.d.mts",
        "default": "./dist/generators/index.mjs"
      },
      "require": {
        "types": "./dist/generators/index.d.cts",
        "default": "./dist/generators/index.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query/index.d.mts",
        "default": "./dist/query/index.mjs"
      },
      "require": {
        "types": "./dist/query/index.d.cts",
        "default": "./dist/query/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli/index.d.mts",
        "default": "./dist/cli/index.mjs"
      },
      "require": {
        "types": "./dist/cli/index.d.cts",
        "default": "./dist/cli/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.1"
  },
  "peerDependencies": {
    "typescript": ">=5.9.3"
  },
  "//surrealdb": "Pinned exactly: the driver owns reconnect, session and error behaviour this ORM depends on, and a caret would let a minor change them unreviewed. 2.1.x (current latest) adds WebSocket keepalive pings, connect() rejection on refused or exhausted connections, root-cause errors from Query.collect() and new session-renewal timers; take it as its own change with the full integration and e2e suites run against SurrealDB 3.3.0. 2.0.10 only bumps a transitive dependency.",
  "dependencies": {
    "citty": "^0.2.1",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "oxfmt": "0.71.0",
    "surrealdb": "2.0.9",
    "ts-toolbelt": "^9.6.0",
    "valibot": "^1.2.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "prepublishOnly": "bun run build",
    "generate:test-client": "bun run bin/cerial.ts generate -s tests/e2e/schemas -o tests/e2e/generated",
    "typecheck": "tsc --noEmit -p tests/e2e/typechecks/tsconfig.json && tsc --noEmit -p tests/unit/typechecks/tsconfig.json",
    "test": "bun test tests/unit/ tests/generators/ tests/parser/ tests/query/ tests/client/ tests/validators/ tests/utils/",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "bun test tests/e2e/ --preload ./tests/e2e/preload.ts",
    "test:full": "bun run generate:test-client && bun run typecheck && bun run test && bun run test:integration && bun run test:e2e",
    "snapshot:update": "UPDATE_GOLDEN=1 bun test tests/generators/golden-snapshot.test.ts",
    "format": "oxfmt --write . && oxlint --fix --deny-warnings .",
    "format:check": "oxfmt --check . && oxlint --deny-warnings .",
    "publish:npm": "npm publish --access public"
  }
}
