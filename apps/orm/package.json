{
  "name": "cerial",
  "version": "0.3.0",
  "description": "A Prisma-like ORM for SurrealDB with schema-driven code generation and full TypeScript type safety",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerial-orm/cerial.git",
    "directory": "apps/orm"
  },
  "homepage": "https://cerial-orm.github.io/cerial",
  "bugs": {
    "url": "https://github.com/cerial-orm/cerial/issues"
  },
  "author": "younusdev",
  "keywords": [
    "surrealdb",
    "orm",
    "prisma",
    "typescript",
    "codegen",
    "schema",
    "query-builder",
    "database"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "cerial": "./dist/bin/cerial.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.mts",
        "default": "./dist/schema/index.mjs"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser/index.d.mts",
        "default": "./dist/parser/index.mjs"
      },
      "require": {
        "types": "./dist/parser/index.d.cts",
        "default": "./dist/parser/index.cjs"
      }
    },
    "./generators": {
      "import": {
        "types": "./dist/generators/index.d.mts",
        "default": "./dist/generators/index.mjs"
      },
      "require": {
        "types": "./dist/generators/index.d.cts",
        "default": "./dist/generators/index.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query/index.d.mts",
        "default": "./dist/query/index.mjs"
      },
      "require": {
        "types": "./dist/query/index.d.cts",
        "default": "./dist/query/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli/index.d.mts",
        "default": "./dist/cli/index.mjs"
      },
      "require": {
        "types": "./dist/cli/index.d.cts",
        "default": "./dist/cli/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.5",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@7.0.2",
    "unrun": "^0.3.1"
  },
  "peerDependencies": {
    "typescript": ">=5.9.3"
  },
  "//surrealdb": "Pinned exactly: the driver owns reconnect, session and error behaviour this ORM depends on, and a caret would let a minor change them unreviewed. 2.2.1 is the floor because SDKs before 2.1 refuse a SurrealDB 4.0 server with a version mismatch. 2.1 added WebSocket keepalive pings, connect() rejection on refused or exhausted connections and root-cause errors from Query.collect(); 2.2.1 reconnects without a limit, capped at 20 s. Take any later bump as its own change with the full integration and e2e suites run.",
  "dependencies": {
    "citty": "^0.2.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "jiti": "^2.7.0",
    "oxfmt": "0.77.0",
    "surrealdb": "2.2.2",
    "ts-toolbelt": "^9.6.0",
    "typescript-5.9": "npm:typescript@5.9.3",
    "valibot": "^1.5.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "bench": "bun bench/index.ts",
    "bench:live": "bun bench/live/nested-preread.ts",
    "prepublishOnly": "bun run build",
    "generate:test-client": "bun run bin/cerial.ts generate -s tests/e2e/schemas -o tests/e2e/generated",
    "generate:test-client-ts": "bun run bin/cerial.ts generate -s tests/e2e/schemas-ts -o tests/e2e/generated-ts",
    "generate:mixed-client": "bun tests/e2e/generate-mixed-client.ts",
    "typecheck": "bun run generate:mixed-client && tsc --noEmit -p tests/e2e/typechecks/tsconfig.json && tsc --noEmit -p tests/unit/typechecks/tsconfig.json",
    "typecheck:generated": "bun tests/e2e/typecheck-generated.ts",
    "typecheck:ts": "bun run generate:test-client-ts && bun tests/e2e/typecheck-ts.ts",
    "typecheck:layout": "bun tests/e2e/typecheck-layout.ts",
    "test": "bun test tests/unit/ tests/generators/ tests/parser/ tests/query/ tests/client/ tests/validators/ tests/utils/",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "bun test tests/e2e/ --preload ./tests/e2e/preload.ts",
    "test:e2e:ts": "bun test tests/e2e/ --preload ./tests/e2e/preload-ts.ts",
    "test:e2e:parallel": "bun test tests/e2e/ --preload ./tests/e2e/preload.ts --parallel=${CERIAL_E2E_WORKERS:-4}",
    "test:full": "bun run generate:test-client && bun run typecheck && bun run test && bun run test:integration && bun run test:e2e",
    "snapshot:update": "UPDATE_GOLDEN=1 bun test tests/generators/golden-snapshot.test.ts",
    "format": "oxfmt --write . && oxlint --fix --deny-warnings .",
    "format:check": "oxfmt --check . && oxlint --deny-warnings .",
    "publish:npm": "npm publish --access public"
  }
}
