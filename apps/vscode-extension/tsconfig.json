{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "lib": ["ESNext"],
    "types": ["node", "jest", "mocha", "@types/bun"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    // Unused bindings are oxlint's job repo-wide (eslint/no-unused-vars, --deny-warnings in CI). oxlint honours
    // the `_` prefix; TypeScript does not for locals, and this project compiles apps/orm/src through relative imports.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["client/src/**/*", "server/src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
